#!/usr/bin/env ruby
# frozen_string_literal: true

# Silence stderr and take stdout before loading anything, so nothing printed
# or warned while the enclave loads, nor a LoadError's backtrace, gets out.
# ErrorFilter.silence_stderr! and CLI.claim_stdout! do the same, but they need the
# enclave loaded first.
STDERR.reopen(File::NULL, "w") # rubocop:disable Style/GlobalStdStream
$stderr = STDERR
out = STDOUT.dup # rubocop:disable Style/GlobalStdStream
STDOUT.reopen(File::NULL, "w") # rubocop:disable Style/GlobalStdStream
$stdout = STDOUT

# The enclave deploys by gem install only (DESIGN.md, "Deploying the enclave").
# A driver gem that's loadable here, as under the repo's own bundle, means
# the wrong deploy, so refuse before loading anything. The repo's specs set
# QUAACKS_DEV_CHECKOUT=1 to run it from a checkout. It counts only when this
# file sits in a git checkout, with a .git and a Gemfile two levels up, so
# exporting it by mistake on a jump server, where quaacks is an installed
# gem, leaves the guard on.
# Gem.find_files searches the load path and every installed gem.
checkout = File.expand_path("../..", __dir__)
dev_checkout = ENV["QUAACKS_DEV_CHECKOUT"] == "1" &&
               %w[.git Gemfile].all? { File.exist?(File.join(checkout, it)) }
if !dev_checkout && Gem.find_files("quaack/driver/version.rb").any?
  out.write(%({"type":"error","rule":"driver_present"}\n))
  exit 1
end

require "quaack/enclave"

exit Quaack::Enclave::CLI.main(ARGV, out:)
